# Grandstream HT812V2 ATA
HT812_HOST=https://192.168.0.160
HT812_ADMIN_USER=admin
HT812_ADMIN_PASS=admin

# Host/IP that HT812 should register against from the LAN
ASTERISK_SIP_HOST=host.docker.internal

# SIP credentials for HT812V2 FXS ports (must match pjsip.conf)
SIP_1001_PASS=changeme1
SIP_1002_PASS=changeme2

# Asterisk ARI (REST Interface)
ARI_USER=ari-user
ARI_PASS=changeme_ari
ARI_HOST=asterisk
ARI_PORT=8088

# Backup directory (mounted into ht812_api container)
BACKUP_DIR=/backups
BACKUP_KEEP=30

# AGI script — business hours routing
BUSINESS_START=9
BUSINESS_END=17
LOCAL_TZ_OFFSET=8

# ARI app — call recording (true/false)
ARI_ENABLE_RECORDING=false
EVENTS_API_URL=http://ht812_api:8000/events

# Browser dashboard
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
